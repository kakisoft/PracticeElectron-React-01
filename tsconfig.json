{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["DOM", "ES2019"],
    "jsx": "react",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["main.ts", "renderer.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
