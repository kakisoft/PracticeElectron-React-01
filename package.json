{
  "name": "practice-electron-react-01",
  "version": "1.0.0",
  "description": "Simple Electron + React 17 learning sample",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron . --disable-gpu --disable-software-rasterizer --no-sandbox",
    "dev": "npm run build && node scripts/dev.js"
  },
  "electronmon": {
    "patterns": [
      "!main.ts",
      "!renderer.tsx",
      "!src/**/*.ts",
      "!src/**/*.tsx",
      "!README.md",
      "!Electron_note01.md",
      "!_note_Redux_01.md"
    ]
  },
  "devDependencies": {
    "@types/node": "^14.18.36",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "electron": "^25.9.0",
    "electronmon": "^2.0.4",
    "typescript": "4.4.3"
  },
  "dependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2"
  }
}
